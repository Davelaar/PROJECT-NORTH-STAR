# Open Filament — local defaults
DATABASE_URL=file:../../data/open-filament.sqlite
API_HOST=127.0.0.1
API_PORT=8787
WEB_ORIGIN=http://127.0.0.1:3000
SESSION_SECRET=dev-only-change-me-in-production-32chars
BRIDGE_PORT=8788
FEATURE_RFID_WRITE=false
FEATURE_SLICER_AUTO_INSTALL=false

# Production (VPS + Caddy profile) example:
# WEB_ORIGIN=https://openfilament.nl,https://www.openfilament.nl
# SESSION_SECRET=<openssl rand -hex 32>
# ACME_EMAIL=admin@openfilament.nl
# WEB_BIND=127.0.0.1

# Public site URL (canonical / sitemap / OG)
NEXT_PUBLIC_SITE_URL=https://openfilament.nl

# Consent + contribution terms versions (bump to re-prompt)
NEXT_PUBLIC_CONSENT_VERSION=2026-08-10
NEXT_PUBLIC_CONTRIBUTION_TERMS_VERSION=2026-08-10
CONSENT_VERSION=2026-08-10
CONTRIBUTION_TERMS_VERSION=2026-08-10

# Legal identity — REQUIRED before treating privacy pages as final
# NEXT_PUBLIC_LEGAL_OWNER_NAME=
# NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL=info@openfilament.nl
# NEXT_PUBLIC_LEGAL_SECURITY_EMAIL=info@openfilament.nl
# NEXT_PUBLIC_CONTACT_EMAIL=info@openfilament.nl
# NEXT_PUBLIC_LEGAL_HOSTING_PROVIDER=
# NEXT_PUBLIC_LEGAL_HOSTING_REGION=EU
# NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=2026-08-10
# LEGAL_OWNER_NAME=
# LEGAL_PRIVACY_EMAIL=
# LEGAL_HOSTING_REGION=

# Google Analytics 4 — leave empty to disable; never loads before consent
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# NEXT_PUBLIC_ENABLE_GA_IN_DEV=false

API_RATE_LIMIT_MAX=300

# Amazon.nl Associates tag for where-to-buy links (default: 3dapeldoorn-21)
AMAZON_AFFILIATE_TAG=3dapeldoorn-21

# Stripe (test keys only in non-production; never commit real secrets)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_MODE=test
