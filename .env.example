# Open Filament — local defaults
DATABASE_URL=file:../../data/open-filament.sqlite
API_HOST=127.0.0.1
API_PORT=8787
WEB_ORIGIN=http://127.0.0.1:3000
SESSION_SECRET=dev-only-change-me-in-production-32chars
BRIDGE_PORT=8788
FEATURE_RFID_WRITE=false
FEATURE_SLICER_AUTO_INSTALL=false

# Production (VPS + Caddy profile) example:
# WEB_ORIGIN=https://openfilament.nl,https://www.openfilament.nl
# SESSION_SECRET=<openssl rand -hex 32>
# ACME_EMAIL=admin@openfilament.nl
# WEB_BIND=127.0.0.1

# Amazon.nl Associates tag for where-to-buy links (default: 3dapeldoorn-21)
AMAZON_AFFILIATE_TAG=3dapeldoorn-21
